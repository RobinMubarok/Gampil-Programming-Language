\ Conditional / Guard test for Gampil compiler

bitOff main[asc8()() args]:
    num16 x be 5

    \ Simple if guard
    if x > 3:
        printf ["x is greater than 3\n"]
      but
    x = 5:
        printf ["x is equal to 5\n"]
      but
    else and x < 10:
        printf ["x is less than 10 (exclusive)\n"]
      but
    ok

    \ Boolean operators
    num16 a be 1
    num16 b be 0
    if a and not b:
        printf ["a is true, b is false\n"]
      but
    ok
  ok
