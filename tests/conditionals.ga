    num32 x be 10

    if x < 5:
        printf["x is less than 5\n"]
    but x = 5:
        printf["x is 5\n"]
    but else:
        printf["x is greater than 5 (else block hit)\n"]
    ok

    num32 y be 20
    if y = 10:
        printf["y is 10\n"]
    but y > 15 and else:
        printf["y is > 15 and no previous conditions met\n"]
    ok

    if y = 20:
        printf["y is 20\n"]
    but y > 15 or else and false:
        printf["y > 15 or (else and false)\n"]
